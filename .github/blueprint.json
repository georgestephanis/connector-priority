{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Connector Priority",
		"author": "George Stephanis",
		"description": "Drag-and-drop priority ordering for AI connectors on Settings > Connectors. Installs the Anthropic, OpenAI, and Ultimate AI compatible-endpoints connectors so you have multiple providers to reorder."
	},
	"landingPage": "/wp-admin/options-connectors.php",
	"preferredVersions": {
		"php": "8.3",
		"wp": "nightly"
	},
	"steps": [
		{
			"step": "login",
			"username": "admin",
			"password": "password"
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/georgestephanis/connector-priority",
				"ref": "trunk",
				"refType": "branch",
				"path": "/"
			},
			"options": {
				"activate": true,
				"targetFolderName": "connector-priority"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "ai-provider-for-anthropic"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "ai-provider-for-openai"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/Ultimate-Multisite/ultimate-ai-connector-compatible-endpoints",
				"ref": "main",
				"refType": "branch",
				"path": "/"
			},
			"options": {
				"activate": true,
				"targetFolderName": "ultimate-ai-connector-compatible-endpoints"
			}
		}
	]
}
